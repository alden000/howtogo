{
  "name": "howtogo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "src/shared",
    "src/web",
    "src/worker"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test \"scripts/android/test/*.test.mjs\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gate": "bash qa/gate.sh",
    "build:release": "VITE_API_BASE= npm run build -w @howtogo/web",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "android:release": "bash src/android/scripts/release.sh",
    "android:stage": "node scripts/android/stage-apk.mjs",
    "deploy:prod": "node scripts/deploy.mjs production",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "smoke:live": "node scripts/smoke-live.mjs"
  }
}
