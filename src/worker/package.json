{
  "name": "@howtogo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "embed": "node scripts/embed-assets.mjs",
    "pretest": "node scripts/embed-assets.mjs --if-stale",
    "test": "vitest run",
    "pretypecheck": "node scripts/embed-assets.mjs --if-stale",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "dev:fixtures": "wrangler dev --var FIXTURE_MODE:1",
    "dev:embed": "node scripts/embed-assets.mjs && wrangler dev -c wrangler.embed.toml",
    "embed:config": "node scripts/embed-config.mjs",
    "record:lta": "node scripts/record-lta.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.3",
    "@cloudflare/workers-types": "^4.20260702.1",
    "vitest": "5.1.0",
    "typescript": "~5.9.3",
    "wrangler": "4.163.0"
  }
}
